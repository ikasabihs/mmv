#!/usr/bin/env bash
# mmv - Magic Move/Copy
# Enter: フォルダに入る / Tab: このフォルダ自体を選択 / m: 移動 / c: コピー

MARK_UP="__UP__"
MARK_HERE="__HERE__"
MARK_DIR="__DIR__"
MARK_FILE="__FILE__"

navigate() {
    local mode="$1"
    local current_dir="${2:-$HOME}"

    while true; do
        local items=()

        if [ "$mode" = "source" ]; then
            local header="[移動/コピー元] $current_dir  |  Enter:フォルダに入る  Tab:このフォルダを選択"
        else
            local header="[移動/コピー先] $current_dir"
        fi

        [ "$current_dir" != "/" ] && items+=("${MARK_UP}|⬆  .. (上に戻る)")
        [ "$mode" = "dest" ]      && items+=("${MARK_HERE}|✅ ここに決定")

        while IFS= read -r d; do
            items+=("${MARK_DIR}|📁 $(basename "$d")")
        done < <(find "$current_dir" -maxdepth 1 -mindepth 1 -type d ! -name '.*' | sort)

        if [ "$mode" = "source" ]; then
            while IFS= read -r f; do
                items+=("${MARK_FILE}|📄 $(basename "$f")")
            done < <(find "$current_dir" -maxdepth 1 -mindepth 1 ! -type d ! -name '.*' | sort)
        fi

        # fzfの結果：通常選択かTabかを区別するため出力にプレフィックスをつける
        local choice action
        choice=$(printf '%s\n' "${items[@]}" | \
            awk -F'|' '{print $2}' | \
            fzf \
                --prompt="$([ "$mode" = "source" ] && echo "ファイル選択 > " || echo "移動/コピー先 > ")" \
                --height=80% \
                --border \
                --header="$header" \
                --expect=tab)

        [ -z "$choice" ] && return 1

        # 1行目がキー、2行目が選択内容
        action=$(echo "$choice" | head -1)
        local selected
        selected=$(echo "$choice" | tail -1)

        [ -z "$selected" ] && return 1

        local clean_name
        clean_name=$(echo "$selected" | sed 's/^📁 //;s/^📄 //')

        # Tabキー → フォルダ自体を選択（移動元モードのみ）
        if [ "$action" = "tab" ] && [ "$mode" = "source" ]; then
            if [ -d "$current_dir/$clean_name" ]; then
                echo "$current_dir/$clean_name"
                return 0
            fi
        fi

        if [[ "$selected" == "⬆  .. (上に戻る)" ]]; then
            current_dir="$(dirname "$current_dir")"

        elif [[ "$selected" == "✅ ここに決定" ]]; then
            echo "$current_dir"
            return 0

        else
            if [ -d "$current_dir/$clean_name" ]; then
                current_dir="$current_dir/$clean_name"
            elif [ -f "$current_dir/$clean_name" ]; then
                echo "$current_dir/$clean_name"
                return 0
            fi
        fi
    done
}

# メインループ
while true; do
    SOURCE=$(navigate "source" "$HOME")
    [ $? -ne 0 ] && echo "終了します。" && break
    [ -z "$SOURCE" ] && continue

    FILENAME=$(basename "$SOURCE")

    echo ""
    echo "  対象: $FILENAME"
    echo "  ┌─────────────────────────┐"
    echo "  │  [m] 移動   [c] コピー  │"
    echo "  │  [q] キャンセル         │"
    echo "  └─────────────────────────┘"

    while true; do
        read -rsn1 KEY
        case "$KEY" in
            m|M) ACTION="move"; echo "  → 移動"; break ;;
            c|C) ACTION="copy"; echo "  → コピー"; break ;;
            q|$'\e') ACTION="cancel"; echo "  → キャンセル"; break ;;
        esac
    done

    [ "$ACTION" = "cancel" ] && continue

    DEST_DIR=$(navigate "dest" "$HOME")
    if [ $? -ne 0 ] || [ -z "$DEST_DIR" ]; then
        echo "キャンセル。最初からやり直します。"
        continue
    fi

    DEST_PATH="$DEST_DIR/$FILENAME"

    echo "元: $SOURCE"
    echo "先: $DEST_PATH"

    if [ "$ACTION" = "move" ]; then
        mv -- "$SOURCE" "$DEST_PATH" \
            && echo "✅ 移動完了: $FILENAME → $DEST_DIR" \
            || echo "❌ エラー"
    else
        cp -r -- "$SOURCE" "$DEST_PATH" \
            && echo "✅ コピー完了: $FILENAME → $DEST_DIR" \
            || echo "❌ エラー"
    fi

done
